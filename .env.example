# Local Docker deployment. Replace before deploying. Use URL-safe characters.
DB_PASSWORD=replace_with_a_long_random_password
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
# For development outside Docker only (point at your local PostgreSQL):
# DATABASE_URL=postgres://chess:password@localhost:5432/chess
# PORT=3000

# External PostgreSQL providers with a private CA (e.g. Aiven):
# Download the provider CA and mount/upload it; never disable certificate verification.
# DATABASE_SSL_CA_FILE=/etc/secrets/aiven-ca.pem
# Alternatively set DATABASE_SSL_CA to the PEM certificate in your host's environment UI.
