# Local Docker deployment. Replace before deploying. Use URL-safe characters.
DB_PASSWORD=replace_with_a_long_random_password
APP_ORIGIN=http://localhost:8080
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
